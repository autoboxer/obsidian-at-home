{
  "name": "obsidian-at-home",
  "private": true,
  "version": "1.5.0",
  "description": "A local-only desktop app for writing, organizing, and linking Markdown notes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "icons": "tauri icon src-tauri/icons/icon-source.png",
    "desktop:mac": "npm run icons && tauri build --bundles app,dmg",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run build && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "keywords": [
    "markdown",
    "notes",
    "tauri",
    "local-only"
  ],
  "author": "Jared Collier",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lezer/common": "^1.5.6",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "highlight.js": "^11.12.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
