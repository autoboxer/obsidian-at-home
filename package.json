{
  "name": "obsidian-at-home",
  "private": true,
  "version": "1.2.0",
  "description": "A local-only desktop app for writing, organizing, and linking Markdown notes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "icons": "tauri icon src-tauri/icons/icon-source.png",
    "desktop:mac": "npm run icons && tauri build --bundles app,dmg",
    "tauri": "tauri",
    "check": "npm run build && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "keywords": [
    "markdown",
    "notes",
    "tauri",
    "local-only"
  ],
  "author": "Jared Collier",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@lezer/common": "^1.5.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "highlight.js": "^11.11.1",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vue-tsc": "^2.2.12"
  }
}
